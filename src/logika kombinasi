#include <Arduino.h>

#define LED_MERAH 25
#define LED_KUNING 27
#define LED_HIJAU 32
#define PUSH_BUTTON 33
#define potensiometer 34

void setup(){
  Serial.begin(115200);
  pinMode(potensiometer,INPUT);
  pinMode(PUSH_BUTTON,INPUT_PULLUP);

  pinMode(LED_MERAH, OUTPUT);
  pinMode(LED_KUNING, OUTPUT);
  pinMode(LED_HIJAU, OUTPUT);

  Serial.println("4. Rangkaian Kombinasi");
}

void loop(){
  int rawADC = analogRead(potensiometer);

  float tegangan = (rawADC/4096.0)*3.3;

  float hambatan = (tegangan/3.3)*10000.0;

   if(digitalRead(PUSH_BUTTON) == LOW){
    digitalWrite(LED_MERAH, LOW);
    digitalWrite(LED_KUNING, LOW);
    digitalWrite(LED_HIJAU, LOW);
    delay(100);
  }

  else{
    if(tegangan >= 0 && tegangan < 1.65){
      digitalWrite(LED_MERAH, HIGH);
      digitalWrite(LED_KUNING, LOW);
      digitalWrite(LED_HIJAU, LOW);
    }

    else if(tegangan >= 1.65 && tegangan < 2.8){
      digitalWrite(LED_MERAH, LOW);
      digitalWrite(LED_KUNING, HIGH);
      digitalWrite(LED_HIJAU, LOW);
    }

    else{
      digitalWrite(LED_MERAH, LOW);
      digitalWrite(LED_KUNING, LOW);
      digitalWrite(LED_HIJAU, HIGH);
    }
  }
}